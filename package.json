{
  "name": "compose-healthgen",
  "version": "0.1.0",
  "description": "Zero-config CLI to add healthchecks to docker-compose.yml",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "compose-healthgen": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "tsx src/test.ts",
    "test:e2e": "tsx src/e2e.ts",
    "test:flows": "tsx src/e2e-flows.ts"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "diff": "^5.2.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/diff": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
